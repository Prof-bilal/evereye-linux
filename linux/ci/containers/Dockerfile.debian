ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}
# Apt exits 0 even when every index fails to download (for example a DNS blip
# inside BuildKit), which then reads as "Unable to locate package" for
# everything. Require a real Packages index and retry the fetch.
RUN set -eux; \
    ok=0; \
    for attempt in 1 2 3 4 5; do \
        apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update || true; \
        if ls /var/lib/apt/lists/*Packages* >/dev/null 2>&1; then ok=1; break; fi; \
        sleep 15; \
    done; \
    [ "$ok" = 1 ]; \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential cmake ninja-build qt6-base-dev qt6-base-dev-tools qmake6 qt6-wayland qt6-wayland-dev \
        libgl1-mesa-dev upower dbus dbus-x11 libglib2.0-bin python3 desktop-file-utils appstream \
        xvfb weston xauth fonts-dejavu-core ca-certificates file binutils dpkg-dev; \
    rm -rf /var/lib/apt/lists/*
