ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}
# Archive mirrors intermittently answer an update with a partial or empty index,
# which surfaces as "Unable to locate package" for every package. Retry the
# index fetch a few times and fail loudly if it never succeeds.
RUN set -eux; \
    ok=0; \
    for attempt in 1 2 3 4 5; do \
        if apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update; then ok=1; break; fi; \
        sleep 10; \
    done; \
    [ "$ok" = 1 ]; \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential cmake ninja-build qt6-base-dev qt6-base-dev-tools qmake6 qt6-wayland qt6-wayland-dev \
        libgl1-mesa-dev upower dbus dbus-x11 libglib2.0-bin python3 desktop-file-utils appstream \
        xvfb weston xauth fonts-dejavu-core ca-certificates file binutils dpkg-dev; \
    rm -rf /var/lib/apt/lists/*
