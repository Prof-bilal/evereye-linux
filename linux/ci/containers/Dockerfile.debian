ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}
# Apt exits 0 even when every index fails to download (for example a DNS blip
# inside CI), and a partial index still contains a Packages file. Attempt the
# install itself on each source set and only accept the first that succeeds:
# stock sources, then kernel.org for the amd64 archive, then mirrors that
# serve ubuntu-ports for arm64.
RUN set -eux; \
    files=""; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources; do \
        if [ -f "$f" ]; then files="$files $f"; fi; \
    done; \
    [ -n "$files" ]; \
    ok=0; \
    for stage in stock kernel ports-ocf ports-rit; do \
        case "$stage" in \
            stock) : ;; \
            kernel) sed -i -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.edge.kernel.org/ubuntu|g' \
                             -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.edge.kernel.org/ubuntu|g' $files ;; \
            ports-ocf) sed -i -E 's|https?://ports.ubuntu.com/ubuntu-ports|http://mirrors.ocf.berkeley.edu/ubuntu-ports|g' $files ;; \
            ports-rit) sed -i -E 's|https?://mirrors.ocf.berkeley.edu/ubuntu-ports|http://mirrors.rit.edu/ubuntu-ports|g' $files ;; \
        esac; \
        rm -rf /var/lib/apt/lists/*; \
        mkdir -p /var/lib/apt/lists/partial; \
        apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=30 update || true; \
        if DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
                build-essential cmake ninja-build qt6-base-dev qt6-base-dev-tools qmake6 qt6-wayland qt6-wayland-dev \
                libgl1-mesa-dev upower dbus dbus-x11 libglib2.0-bin python3 desktop-file-utils appstream \
                xvfb weston xauth fonts-dejavu-core ca-certificates file binutils dpkg-dev; then ok=1; break; fi; \
        sleep 5; \
    done; \
    [ "$ok" = 1 ]; \
    rm -rf /var/lib/apt/lists/*
